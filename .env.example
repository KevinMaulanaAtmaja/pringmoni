# ============================================
# Pringmoni - Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilai-nilainya.
# JANGAN commit .env ke repository!
# ============================================

# --- Database (PostgreSQL via Supabase) ---
# Connection string untuk Prisma migrate & query
DATABASE_URL="postgresql://postgres.[projectref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (tanpa pgbouncer) untuk migration
DIRECT_URL="postgresql://postgres.[projectref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# --- NextAuth ---
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="generate-dengan-openssl-rand-base64-32"
# URL aplikasi (ubah sesuai deployment)
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Storage (UploadThing) ---
# Daftar di https://uploadthing.com
UPLOADTHING_TOKEN="sk_live_xxxx"
UPLOADTHING_APP_ID="app_xxxx"

# --- Supabase Storage (untuk gambar menu) ---
NEXT_PUBLIC_SUPABASE_URL="https://[projectref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbG..."

# --- Gmail SMTP (untuk Reset Password) ---
# Gunakan App Password dari Google Account
GMAIL_EMAIL="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- Midtrans (Pembayaran) ---
# Sandbox: daftar di https://simulator.midtrans.com
# Production: daftar di https://dashboard.midtrans.com
# Set MIDTRANS_IS_PRODUCTION=true hanya jika pakai production key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_MERCHANT_ID="G7xxxxxxx"

# --- Pusher (Real-time, opsional) ---
# NEXT_PUBLIC_PUSHER_KEY="xxxx"
# PUSHER_SECRET="xxxx"
# NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# --- Resend (Email, opsional) ---
# RESEND_API_KEY="re_xxxx"
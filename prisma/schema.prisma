generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id               Int           @id @default(autoincrement())
  email            String?       @unique @map("email")
  username         String        @unique @map("username")
  password         String        @map("password")
  role             RoleUser      @map("role")
  status           Boolean       @default(true) @map("status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime?     @map("updated_at")
  resetToken       String?       @unique @map("reset_token")
  resetTokenExpiry DateTime?     @map("reset_token_expiry")
  /// Versi sesi login akun ini. Bertambah setiap kali ada login baru.
  /// Sesi yang membawa versi lama otomatis tidak berlaku lagi (takeover).
  sessionVersion  Int           @default(0) @map("session_version")
  /// Waktu login terakhir pada akun ini.
  lastLoginAt     DateTime?     @map("last_login_at")
  /// ID perangkat (cookie) yang melakukan login terakhir.
  lastLoginDevice String?       @map("last_login_device")
  /// Waktu terakhir sesi akun ini masih dipakai (request terautentikasi).
  /// Dipakai untuk mendeteksi sesi lain yang benar-benar masih aktif.
  lastSeenAt      DateTime?     @map("last_seen_at")
  logs             Logs[]
  kasirPesanan     Pesanan[]     @relation("KasirPesanan")
  waiterPesanan    Pesanan[]     @relation("WaiterPesanan")
  refundedPesanan  Pesanan[]     @relation("RefundedPesanan")
  riwayatStok      RiwayatStok[]
  shiftKasir       ShiftKasir[]
  kasKeluar        KasKeluar[]

  @@map("users")
}

/// Template slot shift harian yang diatur owner (mis. Pagi 08:00-16:00).
/// Jam disimpan sebagai menit dari tengah malam agar mudah dibandingkan:
/// 480 = 08:00, 960 = 16:00, 1440 = 24:00. Pola sama setiap hari.
model JadwalShift {
  id         Int         @id @default(autoincrement())
  nama       String      @map("nama")
  jamMulai   Int         @map("jam_mulai")
  jamSelesai Int         @map("jam_selesai")
  urutan     Int         @default(1) @map("urutan")
  aktif      Boolean     @default(true) @map("aktif")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime?   @map("updated_at")
  shiftKasir ShiftKasir[]

  @@index([urutan])
  @@map("jadwal_shift")
}

model ShiftKasir {
  id             Int         @id @default(autoincrement())
  kasirId        Int         @map("kasir_id")
  tanggal        DateTime    @map("tanggal") @db.Date
  waktuMasuk     DateTime    @default(now()) @map("waktu_masuk")
  waktuKeluar    DateTime?   @map("waktu_keluar")
  uangAwal       Decimal     @map("uang_awal") @db.Decimal(15, 2)
  uangAkhir      Decimal?    @map("uang_akhir") @db.Decimal(15, 2)
  statusShift    StatusShift @default(ACTIVE) @map("status_shift")
  /// Nyika ACTIVE -> berisi kasirId (mencegah satu kasir punya 2 shift aktif).
  /// Nyika CLOSED -> NULL, sehingga banyak shift tertutup per kasir tetap diizinkan.
  aktifKey       Int?        @unique @map("aktif_key")
  totalTransaksi Int         @default(0) @map("total_transaksi")
  totalPendapatan Decimal    @default(0) @map("total_pendapatan") @db.Decimal(15, 2)
  totalTunai     Decimal     @default(0) @map("total_tunai") @db.Decimal(15, 2)
  totalNonTunai  Decimal     @default(0) @map("total_non_tunai") @db.Decimal(15, 2)
  selisihKas     Decimal?    @map("selisih_kas") @db.Decimal(15, 2)
  keterangan     String?
  /// Shift tertutup milik kasir lain yang uang akhirnya jadi uang awal shift ini
  /// (aturan 7). Tetap dua shift terpisah, tapi serah terima uangnya terlacak.
  sumberShiftId  Int?        @map("sumber_shift_id")
  /// Slot jadwal yang sedang dijalani shift ini (null bila dibuka sebelum fitur jadwal).
  jadwalShiftId  Int?        @map("jadwal_shift_id")
  /// Nyika ACTIVE -> berisi "slot:<jadwalShiftId>" (mencegah 2 shift aktif pada slot
  /// yang sama). Nyika CLOSED -> NULL.
  slotAktifKey   String?     @unique @map("slot_aktif_key")
  /// True bila shift ditutup otomatis oleh sistem (auto-close tengah malam),
  /// bukan oleh kasir. Uang akhir diisi = uang harap akhir.
  autoClosed     Boolean     @default(false) @map("auto_closed")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime?   @map("updated_at")

  kasir          Users         @relation(fields: [kasirId], references: [id])
  pesanan        Pesanan[]
  kasKeluar      KasKeluar[]
  jadwalShift    JadwalShift?  @relation(fields: [jadwalShiftId], references: [id])
  sumberShift    ShiftKasir?   @relation("SerahTerimaShift", fields: [sumberShiftId], references: [id], onDelete: SetNull)
  dipakaiUntuk   ShiftKasir[]  @relation("SerahTerimaShift")

  @@index([kasirId, tanggal])
  @@index([statusShift])
  @@index([sumberShiftId])
  @@index([jadwalShiftId])
  @@map("shift_kasir")
}

/// Pengeluaran tunai selama shift (mis. beli gas). Mengurangi uang yang
/// seharusnya ada di laci: uang harap = uang awal + total tunai - kas keluar.
model KasKeluar {
  id         Int        @id @default(autoincrement())
  shiftId    Int        @map("shift_id")
  nominal    Decimal    @map("nominal") @db.Decimal(15, 2)
  keterangan String     @map("keterangan")
  userId     Int?       @map("user_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  shift      ShiftKasir @relation(fields: [shiftId], references: [id])
  user       Users?     @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@map("kas_keluar")
}

model Meja {
  id         Int        @id @default(autoincrement())
  nomorMeja  String     @unique @map("nomor_meja")
  kapasitas  Int        @map("kapasitas")
  tokenMeja  String?    @unique @map("token_meja")
  statusMeja StatusMeja @default(kosong) @map("status_meja")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  pesanan    Pesanan[]

  @@map("meja")
}

model KategoriMenu {
  id           Int        @id @default(autoincrement())
  namaKategori String     @unique @map("nama_kategori")
  lokasi       LokasiMenu @default(resto) @map("lokasi")
  icon         String?    @map("icon")
  /// Menu di kategori ini bisa dipesan panas ATAU dingin (opsional)
  pilihanSuhu  Boolean    @default(false) @map("pilihan_suhu")
  createdAt    DateTime   @default(now()) @map("created_at")
  deletedAt    DateTime?  @map("deleted_at")
  menus        Menu[]

  @@map("kategori_menu")
}

model Menu {
  id            Int             @id @default(autoincrement())
  namaMenu      String          @unique @map("nama_menu")
  deskripsi     String?         @map("deskripsi")
  harga         Decimal         @map("harga") @db.Decimal(10, 2)
  kategoriId    Int             @map("kategori_id")
  statusMenu    StatusMenu      @default(tersedia) @map("status_menu")
  stokManual    Int             @default(0) @map("stok_manual")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  detailPesanan DetailPesanan[]
  kategori      KategoriMenu    @relation(fields: [kategoriId], references: [id])
  menuFoto      MenuFoto[]
  resep         ResepMenu[]

  @@map("menu")
}

model MenuFoto {
  id        Int       @id @default(autoincrement())
  menuId    Int       @map("menu_id")
  fotoUrl   String    @map("foto_url")
  urutan    Int       @default(1) @map("urutan")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  fileKey   String?   @map("file_key")
  menu      Menu      @relation(fields: [menuId], references: [id])

  @@map("menu_foto")
}

model Pesanan {
  id                    Int               @id @default(autoincrement())
  mejaId                Int               @map("meja_id")
  waiterId              Int?              @map("waiter_id")
  kasirId               Int?              @map("kasir_id")
  statusPesanan         StatusPesanan     @default(menunggu) @map("status_pesanan")
  catatan               String?           @map("catatan")
  refundCatatan         String?           @map("refund_catatan")
  refundedAt            DateTime?         @map("refunded_at")
  refundedById          Int?              @map("refunded_by_id")
  totalHarga            Decimal           @default(0) @map("total_harga") @db.Decimal(10, 2)
  voucherId             Int?              @map("voucher_id")
  diskonVoucher         Decimal           @default(0) @map("diskon_voucher") @db.Decimal(10, 2)
  metodePembayaran      MetodePembayaran? @map("metode_pembayaran")
  jumlahBayar           Decimal?          @map("jumlah_bayar") @db.Decimal(10, 2)
  kembalian             Decimal           @default(0) @map("kembalian") @db.Decimal(10, 2)
  statusPembayaran      StatusBayar       @default(menunggu) @map("status_pembayaran")
  stokDeducted          Boolean           @default(false) @map("stok_deducted")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime?         @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  namaPelanggan         String?           @map("nama_pelanggan")
  midtransOrderId       String?           @unique @map("midtrans_order_id")
  midtransTransactionId String?           @map("midtrans_transaction_id")
  biayaAdmin            Decimal?          @map("biaya_admin") @db.Decimal(10, 2)
  ppn                   Decimal?          @map("ppn") @db.Decimal(10, 2)
  shiftId               Int?              @map("shift_id")
  detailPesanan         DetailPesanan[]
  kasir                 Users?            @relation("KasirPesanan", fields: [kasirId], references: [id])
  meja                  Meja              @relation(fields: [mejaId], references: [id])
  waiter                Users?            @relation("WaiterPesanan", fields: [waiterId], references: [id])
  refundedBy            Users?            @relation("RefundedPesanan", fields: [refundedById], references: [id])
  refundBukti           RefundBukti[]
  voucher               Voucher?          @relation(fields: [voucherId], references: [id])
  shift                 ShiftKasir?       @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("pesanan")
}

model DetailPesanan {
  id             Int         @id @default(autoincrement())
  menuId         Int         @map("menu_id")
  pesananId      Int         @map("pesanan_id")
  jumlah         Int         @map("jumlah")
  hargaSaatPesan Decimal     @map("harga_saat_pesan") @db.Decimal(10, 2)
  catatanItem    String?     @map("catatan_item")
  createdAt      DateTime    @default(now()) @map("created_at")
  statusAntar    StatusAntar @default(belum) @map("status_antar")
  menu           Menu        @relation(fields: [menuId], references: [id])
  pesanan        Pesanan     @relation(fields: [pesananId], references: [id])

  @@map("detail_pesanan")
}

model RefundBukti {
  id        Int      @id @default(autoincrement())
  pesananId Int      @map("pesanan_id")
  fotoUrl   String   @map("foto_url")
  fileKey   String?  @map("file_key")
  createdAt DateTime @default(now()) @map("created_at")
  pesanan   Pesanan  @relation(fields: [pesananId], references: [id])

  @@map("refund_bukti")
}

model Voucher {
  id             Int           @id @default(autoincrement())
  kode           String        @unique @map("kode")
  namaVoucher    String        @map("nama_voucher")
  deskripsi      String?       @map("deskripsi")
  diskonPersen   Int           @map("diskon_persen")
  minimalBelanja Decimal       @default(0) @map("minimal_belanja") @db.Decimal(10, 2)
  statusVoucher  StatusVoucher @default(aktif) @map("status_voucher")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  pesanan        Pesanan[]

  @@map("voucher")
}

model Logs {
  id         Int          @id @default(autoincrement())
  userId     Int?         @map("user_id")
  aksi       JenisAksiLog @map("aksi")
  keterangan String?      @map("keterangan")
  ipAddress  String?      @map("ip_address")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       Users?       @relation(fields: [userId], references: [id])

  @@map("logs")
}

model StokBahan {
  id             Int           @id @default(autoincrement())
  namaBahan      String        @map("nama_bahan")
  tipe           LokasiStok    @map("tipe")
  kategori       KategoriBahan @map("kategori")
  stokQty        Decimal       @map("stok_qty") @db.Decimal(10, 2)
  satuan         SatuanStok    @map("satuan")
  stokMinimum    Decimal       @map("stok_minimum") @db.Decimal(10, 2)
  hargaPerSatuan Decimal       @map("harga_per_satuan") @db.Decimal(10, 2)
  statusStok     StatusStok    @default(tersedia) @map("status_stok")
  keterangan     String?       @map("keterangan")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  riwayatStok    RiwayatStok[]
  resep          ResepMenu[]

  @@unique([namaBahan, tipe])
  @@map("stok_bahan")
}

model RiwayatStok {
  id              Int                @id @default(autoincrement())
  stokBahanId     Int                @map("stok_bahan_id")
  stokSebelum     Decimal            @map("stok_sebelum") @db.Decimal(10, 2)
  stokSesudah     Decimal            @map("stok_sesudah") @db.Decimal(10, 2)
  jumlahPerubahan Decimal            @map("jumlah_perubahan") @db.Decimal(10, 2)
  jenisPerubahan  JenisPerubahanStok @map("jenis_perubahan")
  keterangan      String?            @map("keterangan")
  userId          Int?               @map("user_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  stokBahan       StokBahan          @relation(fields: [stokBahanId], references: [id])
  user            Users?             @relation(fields: [userId], references: [id])

  @@map("riwayat_stok")
}

model ResepMenu {
  id          Int       @id @default(autoincrement())
  menuId      Int       @map("menu_id")
  stokBahanId Int       @map("stok_bahan_id")
  jumlah      Decimal   @map("jumlah") @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  menu        Menu      @relation(fields: [menuId], references: [id])
  stokBahan   StokBahan @relation(fields: [stokBahanId], references: [id])

  @@unique([menuId, stokBahanId])
  @@map("resep_menu")
}

enum RoleUser {
  owner
  cashier
  waiter
}

enum StatusMeja {
  kosong
  terpakai
}

enum StatusMenu {
  tersedia
  habis
  nonaktif
}

enum LokasiMenu {
  resto
  cafe
}

enum StatusPesanan {
  menunggu
  selesai
  dibatalkan
  diproses
  refund
}

enum MetodePembayaran {
  qris
  tunai
  transfer
}

enum StatusBayar {
  menunggu
  berhasil
  dibatalkan
  refund
}

enum StatusAntar {
  belum
  diantar
}

enum StatusShift {
  ACTIVE
  CLOSED
}

enum JenisAksiLog {
  LOGIN
  LOGOUT
  RESET_PASSWORD
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  PINDAH_MEJA
  CANCEL_ORDER_KASIR
  CANCEL_ORDER_EXPIRED
  CANCEL_ORDER_STALE
  PROCESS_PAYMENT
  REFUND_ORDER
  MANAGE_VOUCHER
  EMPTY_TABLE
  OPEN_SHIFT
  CLOSE_SHIFT
  AUTO_CLOSE_SHIFT
  KAS_KELUAR
}

enum StatusVoucher {
  aktif
  nonaktif
}

enum LokasiStok {
  gudang
  dapur
}

enum KategoriBahan {
  bahan_utama
  bumbu
}

enum SatuanStok {
  kg
  gram
  liter
  ml
  pcs
  pack
  bungkus
  sachet
  botol
  kaleng
}

enum StatusStok {
  tersedia
  menipis
  habis
}

enum JenisPerubahanStok {
  restock
  penggunaan
  koreksi
  limbah
  otomatis
  transfer
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id               Int           @id @default(autoincrement())
  email            String?       @unique @map("email")
  username         String        @unique @map("username")
  password         String        @map("password")
  role             RoleUser      @map("role")
  status           Boolean       @default(true) @map("status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime?     @map("updated_at")
  resetToken       String?       @unique @map("reset_token")
  resetTokenExpiry DateTime?     @map("reset_token_expiry")
  logs             Logs[]
  kasirPesanan     Pesanan[]     @relation("KasirPesanan")
  waiterPesanan    Pesanan[]     @relation("WaiterPesanan")
  riwayatStok      RiwayatStok[]

  @@map("users")
}

model Meja {
  id         Int        @id @default(autoincrement())
  nomorMeja  String     @unique @map("nomor_meja")
  kapasitas  Int        @map("kapasitas")
  tokenMeja  String?    @unique @map("token_meja")
  statusMeja StatusMeja @default(kosong) @map("status_meja")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  pesanan    Pesanan[]

  @@map("meja")
}

model KategoriMenu {
  id           Int       @id @default(autoincrement())
  namaKategori String    @unique @map("nama_kategori")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  menus        Menu[]

  @@map("kategori_menu")
}

model Menu {
  id            Int             @id @default(autoincrement())
  namaMenu      String          @unique @map("nama_menu")
  deskripsi     String?         @map("deskripsi")
  harga         Decimal         @map("harga") @db.Decimal(10, 2)
  kategoriId    Int             @map("kategori_id")
  statusMenu    StatusMenu      @default(tersedia) @map("status_menu")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  detailPesanan DetailPesanan[]
  kategori      KategoriMenu    @relation(fields: [kategoriId], references: [id])
  menuFoto      MenuFoto[]

  @@map("menu")
}

model MenuFoto {
  id        Int       @id @default(autoincrement())
  menuId    Int       @map("menu_id")
  fotoUrl   String    @map("foto_url")
  urutan    Int       @default(1) @map("urutan")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  fileKey   String?   @map("file_key")
  menu      Menu      @relation(fields: [menuId], references: [id])

  @@map("menu_foto")
}

model Pesanan {
  id                    Int               @id @default(autoincrement())
  mejaId                Int               @map("meja_id")
  waiterId              Int?              @map("waiter_id")
  kasirId               Int?              @map("kasir_id")
  statusPesanan         StatusPesanan     @default(menunggu) @map("status_pesanan")
  catatan               String?           @map("catatan")
  totalHarga            Decimal           @default(0) @map("total_harga") @db.Decimal(10, 2)
  metodePembayaran      MetodePembayaran? @map("metode_pembayaran")
  jumlahBayar           Decimal?          @map("jumlah_bayar") @db.Decimal(10, 2)
  kembalian             Decimal           @default(0) @map("kembalian") @db.Decimal(10, 2)
  statusPembayaran      StatusBayar       @default(menunggu) @map("status_pembayaran")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime?         @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  namaPelanggan         String?           @map("nama_pelanggan")
  midtransOrderId       String?           @unique @map("midtrans_order_id")
  midtransTransactionId String?           @map("midtrans_transaction_id")
  biayaAdmin            Decimal?          @map("biaya_admin") @db.Decimal(10, 2)
  ppn                   Decimal?          @map("ppn") @db.Decimal(10, 2)
  detailPesanan         DetailPesanan[]
  kasir                 Users?            @relation("KasirPesanan", fields: [kasirId], references: [id])
  meja                  Meja              @relation(fields: [mejaId], references: [id])
  waiter                Users?            @relation("WaiterPesanan", fields: [waiterId], references: [id])

  @@map("pesanan")
}

model DetailPesanan {
  id             Int         @id @default(autoincrement())
  menuId         Int         @map("menu_id")
  pesananId      Int         @map("pesanan_id")
  jumlah         Int         @map("jumlah")
  hargaSaatPesan Decimal     @map("harga_saat_pesan") @db.Decimal(10, 2)
  catatanItem    String?     @map("catatan_item")
  createdAt      DateTime    @default(now()) @map("created_at")
  statusAntar    StatusAntar @default(belum) @map("status_antar")
  menu           Menu        @relation(fields: [menuId], references: [id])
  pesanan        Pesanan     @relation(fields: [pesananId], references: [id])

  @@map("detail_pesanan")
}

model Logs {
  id         Int          @id @default(autoincrement())
  userId     Int?         @map("user_id")
  aksi       JenisAksiLog @map("aksi")
  keterangan String?      @map("keterangan")
  ipAddress  String?      @map("ip_address")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       Users?       @relation(fields: [userId], references: [id])

  @@map("logs")
}

model StokBahan {
  id             Int           @id @default(autoincrement())
  namaBahan      String        @unique @map("nama_bahan")
  kategori       KategoriBahan @map("kategori")
  stokQty        Decimal       @map("stok_qty") @db.Decimal(10, 2)
  satuan         SatuanStok    @map("satuan")
  stokMinimum    Decimal       @map("stok_minimum") @db.Decimal(10, 2)
  hargaPerSatuan Decimal       @map("harga_per_satuan") @db.Decimal(10, 2)
  statusStok     StatusStok    @default(tersedia) @map("status_stok")
  keterangan     String?       @map("keterangan")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  riwayatStok    RiwayatStok[]

  @@map("stok_bahan")
}

model RiwayatStok {
  id              Int                @id @default(autoincrement())
  stokBahanId     Int                @map("stok_bahan_id")
  stokSebelum     Decimal            @map("stok_sebelum") @db.Decimal(10, 2)
  stokSesudah     Decimal            @map("stok_sesudah") @db.Decimal(10, 2)
  jumlahPerubahan Decimal            @map("jumlah_perubahan") @db.Decimal(10, 2)
  jenisPerubahan  JenisPerubahanStok @map("jenis_perubahan")
  keterangan      String?            @map("keterangan")
  userId          Int?               @map("user_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  stokBahan       StokBahan          @relation(fields: [stokBahanId], references: [id])
  user            Users?             @relation(fields: [userId], references: [id])

  @@map("riwayat_stok")
}

enum RoleUser {
  owner
  cashier
  waiter
}

enum StatusMeja {
  kosong
  terpakai
}

enum StatusMenu {
  tersedia
  habis
  nonaktif
}

enum StatusPesanan {
  menunggu
  selesai
  dibatalkan
  diproses
}

enum MetodePembayaran {
  qris
  tunai
  transfer
}

enum StatusBayar {
  menunggu
  berhasil
  dibatalkan
}

enum StatusAntar {
  belum
  diantar
}

enum JenisAksiLog {
  LOGIN
  LOGOUT
  RESET_PASSWORD
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  CANCEL_ORDER_KASIR
  CANCEL_ORDER_EXPIRED
  CANCEL_ORDER_STALE
  PROCESS_PAYMENT
}

enum KategoriBahan {
  bahan_utama
  bumbu
}

enum SatuanStok {
  kg
  pcs
  pack
}

enum StatusStok {
  tersedia
  menipis
  habis
}

enum JenisPerubahanStok {
  restock
  penggunaan
  koreksi
  limbah
}
